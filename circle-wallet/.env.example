# ── Step 1: the one thing only a human can do ──
# Free sandbox/testnet API key from https://console.circle.com (Developer Platform).
CIRCLE_API_KEY=

# ── Step 1 output ──
# `npm run 01-register-entity-secret` generates this and prints it once. Paste it here and
# never run that script again for this same API key — regenerating rotates the secret and
# breaks any wallet already created under the old one.
CIRCLE_ENTITY_SECRET=

# ── Step 2 output ──
# `npm run 02-create-wallet` prints these — paste all three back in before continuing.
CIRCLE_WALLET_SET_ID=
CIRCLE_WALLET_ID=
CIRCLE_WALLET_ADDRESS=

# ── Already have this ──
# The same funded Arc testnet key as contracts/.env's DEPLOYER_PRIVATE_KEY (it deployed and
# owns the Covenant contracts). Used only to create the mandate and to send the new Circle
# wallet some starter Arc gas + demo MockUSDC — it never signs the agent's own payments, so
# it never touches the settlePayment path this is all building toward.
DEPLOYER_PRIVATE_KEY=0xyourprivatekeyhere

# Human/business owner of the mandate this agent will operate under. Leave blank to default
# to the deployer address above.
PRINCIPAL_ADDRESS=
