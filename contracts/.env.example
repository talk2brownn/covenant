# Private key of the account that deploys the Covenant stack. Never commit the real .env file.
DEPLOYER_PRIVATE_KEY=0xyourprivatekeyhere

# Arc testnet RPC endpoint (see Arc docs for the current URL / chain ID).
ARC_TESTNET_RPC_URL=https://replace-with-arc-testnet-rpc

# Optional: Arc block explorer API key, once verification is supported there.
ARC_EXPLORER_API_KEY=
